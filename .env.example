# Copy to `.dev.vars` for local preview (wrangler) or set these in the
# Cloudflare dashboard for the live site. Never commit real values.

# PushPress Platform API — developer.pushpress.com → API keys.
# company-id is the gym's location ID shown next to the key.
PUSHPRESS_API_KEY=
PUSHPRESS_COMPANY_ID=

# Brevo (email notifications when the contact form is submitted).
# Brevo dashboard → SMTP & API → API keys.
BREVO_API_KEY=
# Where lead emails go and who they appear to be from (must be a verified Brevo sender).
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=

# Cloudflare Turnstile (optional spam protection on the contact form).
TURNSTILE_SECRET_KEY=
