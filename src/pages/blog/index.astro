---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPublishedArticles, formatDate, estimateReadTime } from '../../lib/content';
import { categoryLabel } from '../../lib/pack';
import { crumbs } from '../../lib/seo';

const articles = await getPublishedArticles();
const items = [{ name: 'Blog', url: '/blog/' }];
---

<BaseLayout
  title="Blog — Strength Training Advice from Corvallis Coaches"
  description="Plain-language answers from the Helix Training coaches: strength training after 50, getting started, recovery, nutrition, and staying consistent. Written by a Doctor of Physical Therapy and her team."
  jsonLd={[crumbs(items)]}
>
  <div class="container">
    <Breadcrumbs items={items} />
    <PageHeader title="From the coaches" lede="The questions we hear on the gym floor, answered properly — with sources." />
    {articles.length === 0 ? (
      <div class="notice">
        <p><strong>First articles are on the way.</strong> In the meantime, <a href="/faq/">the FAQ</a> answers the most common questions.</p>
      </div>
    ) : (
      <ul class="post-list">
        {articles.map((a) => (
          <li>
            <span class="tag">{categoryLabel(a.data.category)}</span>
            <h3><a href={`/blog/${a.id}/`}>{a.data.title}</a></h3>
            <p class="muted">{a.data.excerpt}</p>
            <div class="article-meta">
              <span>{a.data.author}</span>
              <span>{formatDate(a.data.publishDate)}</span>
              <span>{a.data.readTime ?? estimateReadTime(a.body)}</span>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
