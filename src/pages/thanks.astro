---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Thanks — we got your message" description="Your message reached Helix Training." robots="noindex,nofollow">
  <div class="container" style="padding-block: var(--s3); max-width: var(--measure)">
    <h1>Got it. We'll be in touch soon.</h1>
    <p class="lede">A coach will get back to you.</p>
    <p>Want to skip the wait? Your first class is free — pick a time and come meet us.</p>
    <a class="btn btn--primary" href="/free-class/">Book a free class</a>
  </div>
</BaseLayout>
