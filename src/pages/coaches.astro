---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { render } from 'astro:content';
import { personGraph } from '@jeldon/schema-graph';
import { getCoaches } from '../lib/content';
import { crumbs } from '../lib/seo';
import { pack } from '../lib/pack';

const coaches = await getCoaches();
const rendered = await Promise.all(coaches.map(async (c) => ({ c, Content: (await render(c)).Content })));
const items = [{ name: 'Coaches', url: '/coaches/' }];

// The owner's Person node links every article's author @id (E-E-A-T).
const owner = pack.authors.find((a) => a.isPrimary) ?? pack.authors[0];
const ownerNode = personGraph({
  schemaId: owner.schemaId,
  profile: owner.profile,
  siteUrl: pack.brand.siteUrl,
});
const initials = (name: string) => name.replace(/^Dr\.\s*/, '').split(' ').map((w) => w[0]).slice(0, 2).join('');
---

<BaseLayout
  title="Coaches"
  description="Meet the Helix Training coaching team in Corvallis — led by owner Dr. Kathy Lynch, PT, DPT, with coaches who scale every workout to the person in front of them."
  jsonLd={[crumbs(items), ownerNode as Record<string, unknown>]}
>
  <div class="container">
    <Breadcrumbs items={items} />
    <PageHeader
      title="Meet the coaches"
      lede="We'll handle the plan. You bring the effort. Every coach here cares about guiding and encouraging each member toward the goals they set for themselves."
    />
    <div class="grid grid--2" style="gap: var(--s2)">
      {rendered.map(({ c, Content }) => (
        <div class="coach" id={c.id}>
          {c.data.photo ? (
            <img src={c.data.photo} alt={c.data.photoAlt ?? c.data.name} width="80" height="80" loading="lazy" />
          ) : (
            <div class="avatar" aria-hidden="true">{initials(c.data.name)}</div>
          )}
          <div>
            <h3>{c.data.name}{c.data.credentials ? `, ${c.data.credentials}` : ''}</h3>
            <p class="role">{c.data.role}</p>
            <div class="prose"><Content /></div>
            {c.data.specialties.length > 0 && (
              <p>{c.data.specialties.map((s) => <span class="tag">{s}</span>)}</p>
            )}
          </div>
        </div>
      ))}
    </div>
    <section class="section">
      <h2>Want to coach here?</h2>
      <p>We're always glad to hear from coaches who share the philosophy. <a href="/contact/">Send us a note</a> with a bit about yourself.</p>
    </section>
  </div>
</BaseLayout>
