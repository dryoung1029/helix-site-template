---
import type { Program } from '../lib/content';
import { site } from '../../site.config';
interface Props {
  programs: Program[];
}
const { programs } = Astro.props;

function signupHref(p: Program): string {
  const d = p.data;
  if (d.signupUrl) return d.signupUrl;
  if (d.signupPlanKey) {
    const url = (site.pushpress.plans as Record<string, string>)[d.signupPlanKey];
    if (url) return url;
  }
  return '/contact/';
}
---

<ul class="program-list">
  {programs.map((p) => (
    <li class="program-row">
      <div>
        <h3><a href={`/programs/${p.id}/`}>{p.data.name}</a></h3>
        <span class="who">{p.data.audience}</span>
      </div>
      <p>{p.data.tagline}</p>
      <div class="btn-row">
        <a class="btn btn--ghost" href={`/programs/${p.id}/`}>Details</a>
        <a class="btn btn--blue" href={signupHref(p)}>{p.data.signupLabel}</a>
      </div>
    </li>
  ))}
</ul>
